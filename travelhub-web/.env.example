# Mismo valor que `TOKEN_SOPORT_SERVICES` en service-soport (POST /notification/send-email).
# Copia a `.env` o `.env.local` y no subas el archivo con el token real.
VITE_TOKEN_SOPORT_SERVICES=

# Alias opcional (si ya lo usabas): mismo propósito que VITE_TOKEN_SOPORT_SERVICES
# VITE_SOPORT_SEND_EMAIL_BEARER=

# FX (misma base que `VITE_API_URL`): TTL caché cliente de cotizaciones (ms), ej. 600000 = 10 min
# VITE_FX_CACHE_TTL_MS=600000
