# Mismo valor que `TOKEN_SOPORT_SERVICES` en service-soport (POST /notification/send-email).
# Copia a `.env` o `.env.local` y no subas el archivo con el token real.
VITE_TOKEN_SOPORT_SERVICES=

# Alias opcional (si ya lo usabas): mismo propósito que VITE_TOKEN_SOPORT_SERVICES
# VITE_SOPORT_SEND_EMAIL_BEARER=

# FX: raíz del servicio que expone `/currency/v1/*` (en dev suele ser **service-external**, no service-core).
# Si omites esta variable y `VITE_API_URL` termina en `/service-core`, el cliente sustituye por `/service-external`.
# VITE_FX_API_URL=http://localhost:8001/service-external
# TTL caché cliente de cotizaciones (ms), ej. 600000 = 10 min
# VITE_FX_CACHE_TTL_MS=600000
# Tasa USD→COP sólo para UI si el GET rates falla (producción). En `vite dev` hay fallback ~4000 si no está definida.
# VITE_DISPLAY_USD_COP_FALLBACK=4200
#
# Si service-external falla, el cliente reintenta tasas/conversión con Frankfurter (GET …/v2/rate/{base}/{quote}).
# Desactivar: VITE_FX_FRANKFURTER_FALLBACK=false
# Base alternativa (self-host): VITE_FRANKFURTER_BASE_URL=https://api.frankfurter.dev
